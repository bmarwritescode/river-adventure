#!/bin/sh
# Pre-commit check (~30-40 s): type-check + production build, unit tests, quick smoke tests (WebKit).
# Enabled by `npm install` (package.json "prepare" sets core.hooksPath to .githooks).
# Emergency skip: git commit --no-verify   (then run `npm test` before relying on the commit)

# Commits from GUIs (e.g. VS Code) don't load your shell profile: load Node 22 via nvm if present.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
  nvm use --silent >/dev/null 2>&1 || true
fi
major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$major" -lt 22 ]; then
  echo "pre-commit: Node 22+ required (found: $(node -v 2>/dev/null || echo none)). Run 'nvm use'."
  exit 1
fi

echo "pre-commit: build + unit tests + quick smoke tests (skip: git commit --no-verify)"
if ! npm run --silent check; then
  echo ""
  echo "pre-commit: FAILED - commit aborted. Fix the errors above (or see CLAUDE.md 'Stability')."
  exit 1
fi
