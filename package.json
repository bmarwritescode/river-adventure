{
  "name": "hyde-park-dog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "map:build": "uv run --project tools/map python tools/map/build_map.py",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dog:build": "tsx tools/dog/buildDogModel.ts",
    "perf": "tsx tools/perf/runPerf.ts",
    "test:soak": "SOAK=1 playwright test tests/stability.spec.ts --grep @soak",
    "check": "npm run build && vitest run && playwright test tests/smoke.spec.ts --project=webkit --grep @quick",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "lil-gui": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
